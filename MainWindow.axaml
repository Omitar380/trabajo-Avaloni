<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="680"
        Width="440" Height="680"
        MinWidth="360" MinHeight="500"
        x:Class="MiPresentacion.MainWindow"
        Title="MiPresentacion">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="10">
      <TextBlock Text="Mi primera aplicación gráfica"
                 FontSize="22"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,10"/>

      <TextBlock Text="Nombre:" FontWeight="SemiBold"/>
      <TextBox x:Name="TxtNombre" Watermark="Ingresa tu nombre"/>

      <TextBlock Text="Apellido:" FontWeight="SemiBold"/>
      <TextBox x:Name="TxtApellido" Watermark="Ingresa tu apellido"/>

      <TextBlock Text="Edad:" FontWeight="SemiBold"/>
      <TextBox x:Name="TxtEdad" Watermark="Ingresa tu edad"/>

      <Button x:Name="BtnPresentarme"
              Content="Presentarme"
              Click="BtnPresentarme_Click"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Background="#007ACC"
              Foreground="White"
              FontWeight="Bold"/>

      <Button x:Name="BtnLimpiar"
              Content="Limpiar"
              Click="BtnLimpiar_Click"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"/>

      <Button x:Name="BtnCambiarSaludo"
              Content="Cambiar saludo"
              Click="BtnCambiarSaludo_Click"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"/>

      <TextBlock x:Name="TxtResultado"
                 Text="Resultados y mensajes aparecerán aquí."
                 TextWrapping="Wrap"
                 Margin="0,10,0,0"
                 FontStyle="Italic"/>
    </StackPanel>
  </ScrollViewer>
</Window>